# ---------------------------------------------------------------------------
# Loop configuration. Copy to `.env` and fill in the required values.
# At minimum set POSTGRES_PASSWORD and, for the anthropic backend, ANTHROPIC_API_KEY.
# ---------------------------------------------------------------------------

# --- Database ---
# Individual pieces are used by docker-compose to init the db container.
POSTGRES_USER=loop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loop
# Full DSN the app uses. Inside docker-compose the host is `db`.
# For local (non-docker) runs against the dockerised db, use localhost:5432.
POSTGRES_DSN=postgresql+psycopg://loop:change-me@db:5432/loop

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- LLM backend ---
# ollama | anthropic | openai   (this scaffold implements: anthropic, mock)
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
# Cheap tier: per-article event extraction.
LLM_MODEL_SMALL=claude-haiku-4-5
# Strong tier: arc synthesis on high-importance stories only.
LLM_MODEL_LARGE=claude-sonnet-5

# --- Embeddings ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Clustering ---
CLUSTER_THRESHOLD=0.75
CLUSTER_ACTIVE_DAYS=7

# --- Synthesis gating ---
FRESHNESS_GATE_HOURS=2
MIN_SOURCES_FOR_SYNTHESIS=3
IMPORTANCE_THRESHOLD_LARGE_MODEL=0.7

# --- Ranking / personalisation ---
PERSONALIZATION_LAMBDA=0.3
SEEN_PENALTY=0.5

# --- Retention (copyright compliance) ---
BODY_RETENTION_HOURS=72

# --- Ingestion ---
FETCH_INTERVAL_MINUTES=12
FETCH_MAX_CONCURRENCY=8
USER_AGENT=LoopNewsBot/0.1 (+https://github.com/you/loop)

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
